generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
}

model announcement {
  id           Int       @id @default(autoincrement())
  title        String    @db.VarChar(200)
  description  String    @db.Text
  publish_date DateTime  @default(now()) @db.Timestamp(0)
  created_by   Int
  is_active    Int       @default(1) @db.TinyInt
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @default(now()) @db.Timestamp(0)

  @@index([created_by], map: "fk_announcement_created_by")
}

model department {
  id          Int       @id @default(autoincrement())
  dept_name   String    @unique(map: "dept_name") @db.VarChar(100)
  description String?   @db.VarChar(225)
  is_active   Int       @default(1) @db.TinyInt
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
}

model priority {
  id            Int       @id @default(autoincrement())
  priority_name String    @unique(map: "priority_name") @db.VarChar(50)
  is_active     Int       @default(1) @db.TinyInt
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
}

model roles {
  role_id    Int       @id @default(autoincrement())
  role       String    @unique(map: "role") @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  is_active  Int?
}

model status {
  id          Int       @id @default(autoincrement())
  status_name String    @unique(map: "status_name") @db.VarChar(50)
  is_active   Int       @default(1) @db.TinyInt
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
}

model tasks {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(200)
  description String?   @db.Text
  assign_to   Int
  created_by  Int
  due_date    DateTime? @db.Date
  priority_id Int
  status_id   Int
  comments    String?   @db.Text
  is_active   Int       @default(1) @db.TinyInt
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)

  @@index([assign_to], map: "fk_tasks_assigned_to")
  @@index([created_by], map: "fk_tasks_created_by")
  @@index([priority_id], map: "fk_tasks_priority")
  @@index([status_id], map: "fk_tasks_status")
}

model users {
  id          Int       @id @default(autoincrement())
  user_name   String    @unique(map: "unique_username") @db.VarChar(100)
  email       String    @unique(map: "unique_email") @db.VarChar(150)
  password    String    @db.VarChar(255)
  role_id     Int
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
  is_active   Int?
  full_name   String    @db.VarChar(150)
  phone       String?   @db.VarChar(20)
  doj         DateTime? @db.Date
  designation String?   @db.VarChar(100)
  dept_id     Int       @default(1)

  @@index([dept_id], map: "fk_users_department")
  @@index([role_id], map: "fk_users_roles")
}
